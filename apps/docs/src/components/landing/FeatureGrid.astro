---
import type { LandingCopy } from '../../i18n/landing.en';
import Card from '../ui/Card.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  t: LandingCopy['features'];
}
const f = Astro.props.t;
---
<section class="border-b border-white/5 px-6 py-24 lg:px-12" aria-labelledby="features-title">
  <div class="mx-auto max-w-7xl">
    <div class="mb-16"><SectionHeading title={f.title} lead={f.lead} titleId="features-title" /></div>
    <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {f.items.map((item) => (
        <li class="flex">
          <Card class="group flex w-full flex-col">
            <div>
              <div class="mb-5 flex size-12 items-center justify-center rounded-xl border border-iron-700 bg-white/5 text-slag">
                <Icon name={item.icon} class="size-6" />
              </div>
              <h3 class="mb-2 font-display text-lg font-semibold text-white">{item.title}</h3>
              <p class="text-sm leading-relaxed text-slag">{item.text}</p>
            </div>
          </Card>
        </li>
      ))}
    </ul>
  </div>
</section>
