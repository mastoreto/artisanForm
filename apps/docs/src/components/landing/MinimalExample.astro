---
import type { LandingCopy } from '../../i18n/landing.en';
import CodeWindow from '../ui/CodeWindow.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  t: LandingCopy['minimal'];
}
const m = Astro.props.t;
---
<section class="border-b border-white/5 px-6 py-20 lg:px-12" aria-labelledby="minimal-title">
  <div class="mx-auto mb-10 max-w-4xl"><SectionHeading title={m.title} lead={m.lead} titleId="minimal-title" /></div>
  <CodeWindow class="mx-auto max-w-4xl" file={m.file} code={m.code} copy={{ label: m.copy, done: m.copied }} />
</section>
