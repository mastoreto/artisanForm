---
import type { LandingCopy } from '../../i18n/landing.en';
import Button from '../ui/Button.astro';
import Callout from '../ui/Callout.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  t: LandingCopy['compat'];
}
const c = Astro.props.t;
---
<section class="border-b border-white/5 px-6 py-20 lg:px-12" aria-labelledby="compat-title">
  <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 lg:grid-cols-12">
    <div class="space-y-6 lg:col-span-7">
      <SectionHeading title={c.title} lead={c.lead} titleId="compat-title" />
      <div class="surface overflow-x-auto" tabindex="0" role="region" aria-label={`${c.head[0]} / ${c.head[1]}`}>
        <table class="w-full border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-white/10 bg-white/[0.04] font-mono text-xs text-slate-300">
              {c.head.map((h, i) => <th scope="col" class:list={['px-5 py-3.5 font-medium', i === 2 && 'text-right']}>{h}</th>)}
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 text-slate-300">
            {c.rows.map(([req, support, status]) => (
              <tr class="transition-colors hover:bg-white/[0.02]">
                <th scope="row" class="px-5 py-3.5 font-semibold text-white">{req}</th>
                <td class="px-5 py-3.5 text-slag">{support}</td>
                <td class="px-5 py-3.5 text-right"><span class="rounded-full border border-iron-700 bg-white/5 px-2.5 py-0.5 font-mono text-xs text-slate-300">{status}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <div class="space-y-4 lg:col-span-5">
      {c.callouts.map((co) => <Callout icon={co.icon} title={co.title}>{co.text}</Callout>)}
      <div class="surface flex items-center justify-between gap-3 p-5">
        <div class="flex items-center gap-3">
          <Icon name={c.status.icon} class="size-6 text-slag" />
          <div>
            <p class="text-sm font-medium text-white">{c.status.title}</p>
            <p class="text-xs text-slag">{c.status.text}</p>
          </div>
        </div>
        <Button href={c.status.href} variant="iron" external class="min-h-11 px-3.5 py-2 text-xs">{c.status.cta}</Button>
      </div>
    </div>
  </div>
</section>
