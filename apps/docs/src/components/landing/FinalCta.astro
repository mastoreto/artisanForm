---
import type { LandingCopy } from '../../i18n/landing.en';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  t: LandingCopy['cta'];
}
const c = Astro.props.t;
---
<section data-forge class="deferred relative overflow-hidden px-6 py-24 text-center lg:px-12" aria-labelledby="cta-title">
  <div class="pointer-events-none absolute -bottom-32 left-1/2 h-80 w-[650px] -translate-x-1/2 bg-[radial-gradient(closest-side,rgb(249_115_22/0.25),transparent)] glow-pulse" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto flex max-w-3xl flex-col items-center">
    <div class="mb-6 flex size-16 items-center justify-center rounded-2xl border border-orange-500/30 bg-gradient-to-tr from-orange-500/20 to-amber-500/20 text-orange-400">
      <Icon name="local-fire-department" class="size-8" />
    </div>
    <h2 id="cta-title" class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">{c.title}</h2>
    <p class="mt-3 max-w-xl text-lg text-zinc-300">{c.lead}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <Button href={c.primary.href}><Icon name="menu-book" class="size-5" />{c.primary.label}</Button>
      <Button href={c.secondary.href} variant="iron" external><Icon name="star" class="size-5 text-amber-400" />{c.secondary.label}</Button>
    </div>
    <p class="mt-12 flex items-center gap-2 font-mono text-xs text-zinc-400"><Icon name="favorite" class="size-4 text-orange-500" />{c.foot}</p>
  </div>
</section>
