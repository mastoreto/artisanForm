---
import type { LandingCopy } from '../../i18n/landing.en';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  t: LandingCopy['cta'];
}
const c = Astro.props.t;
---
<section class="relative overflow-hidden px-6 py-24 text-center lg:px-12" aria-labelledby="cta-title">
  <div class="relative z-10 mx-auto flex max-w-3xl flex-col items-center">
    <div class="mb-6 flex size-16 items-center justify-center rounded-2xl border border-iron-700 bg-white/5 text-slag">
      <Icon name="local-fire-department" class="size-8" />
    </div>
    <h2 id="cta-title" class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">{c.title}</h2>
    <p class="mt-3 max-w-xl text-lg text-slate-300">{c.lead}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <Button href={c.primary.href}><Icon name="menu-book" class="size-5" />{c.primary.label}</Button>
      <Button href={c.secondary.href} variant="iron" external><Icon name="star" class="size-5 text-slag" />{c.secondary.label}</Button>
    </div>
    <p class="mt-12 flex items-center gap-2 font-mono text-xs text-slag"><Icon name="favorite" class="size-4 text-slag" />{c.foot}</p>
  </div>
</section>
