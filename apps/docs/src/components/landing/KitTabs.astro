---
import { Code } from 'astro:components';
import type { LandingCopy } from '../../i18n/landing.en';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  t: LandingCopy['kits'];
}
const k = Astro.props.t;
---
<section id={k.id} class="border-b border-white/5 px-6 py-24 lg:px-12" aria-labelledby="kits-title">
  <div data-tabs class="mx-auto max-w-7xl">
    <div class="mb-12 flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
      <SectionHeading title={k.title} lead={k.lead} titleId="kits-title" />
      <p class="surface flex flex-wrap items-center gap-2 p-1.5 font-mono text-xs">
        <span class="px-3 text-slag">{k.precedence[0]}</span>
        <span class="rounded-xl border border-white/10 bg-white/5 px-2.5 py-1 text-white">{k.precedence[1]}</span><span aria-hidden="true" class="text-slag">➔</span>
        <span class="rounded-xl border border-iron-700 bg-white/5 px-2.5 py-1 text-slag">{k.precedence[2]}</span><span aria-hidden="true" class="text-slag">➔</span>
        <span class="rounded-xl border border-white/10 bg-white/5 px-2.5 py-1 text-slate-300">{k.precedence[3]}</span>
      </p>
    </div>

    <div role="tablist" aria-label={k.listLabel} class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {k.items.map((kit, i) => (
        <button type="button" role="tab" id={`tab-${kit.id}`} aria-controls={`panel-${kit.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}
          class="group flex cursor-pointer flex-col justify-between rounded-2xl border border-white/10 bg-black/50 p-5 text-left transition hover:border-white/20 aria-selected:border-ember aria-selected:ring-1 aria-selected:ring-ember aria-selected:bg-black/70 ">
          <span>
            <span class="mb-3 flex items-center justify-between">
              <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-0.5 font-mono text-xs text-slate-300">{kit.badge}</span>
              <Icon name="check" class="hidden size-4 text-ember group-aria-selected:block" />
            </span>
            <span class="block font-display text-base font-semibold text-white">{kit.name}</span>
            <span class="mt-1 block text-xs text-slag">{kit.text}</span>
          </span>
          <span class="mt-4 block font-mono text-xs text-slag group-aria-selected:text-white">{kit.pkg}</span>
        </button>
      ))}
    </div>

    {k.items.map((kit, i) => (
      <div role="tabpanel" id={`panel-${kit.id}`} aria-labelledby={`tab-${kit.id}`} hidden={i !== 0} tabindex="0" class="code-window surface overflow-hidden shadow-xl shadow-black/40">
        <div class="flex items-center justify-between border-b border-white/10 bg-white/[0.04] px-6 py-3">
          <span class="flex items-center gap-2 font-mono text-xs text-white sm:text-sm"><Icon name="integration-instructions" class="size-4 text-slag" />{kit.title}</span>
          <span class="font-mono text-xs text-slag">{kit.id === 'scss' ? 'SCSS' : 'TSX'}</span>
        </div>
        <Code code={kit.code} lang={kit.id === 'scss' ? 'scss' : 'tsx'} theme="css-variables" />
      </div>
    ))}
  </div>
</section>
