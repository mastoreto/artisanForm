---
import { project } from '../../data/project';
import type { LandingCopy } from '../../i18n/landing.en';
import Icon from '../ui/Icon.astro';
import Pill from '../ui/Pill.astro';

interface Props {
  t: LandingCopy['footer'];
}
const f = Astro.props.t;
---
<footer class="border-t border-white/10 bg-black/80 py-12">
  <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-6 px-6 md:flex-row lg:px-12">
    <div class="text-center md:text-left">
      <p class="font-display text-base font-medium text-white">{f.title}</p>
      <p class="text-xs text-slag">© {f.year} ArtisanForm. {f.text}</p>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-2">
      {f.links.map((l) => <a href={l.href} class="rounded-full px-3 py-1 font-mono text-xs text-slate-300 transition hover:bg-white/5 hover:text-white">{l.label}</a>)}
      {f.chips.map((chip) => <Pill>{chip}</Pill>)}
      <a href="/llms.txt" class="rounded-full px-3 py-1 font-mono text-xs text-slate-300 transition hover:bg-white/5 hover:text-white">{f.llms}</a>
      <a href={project.repo} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 rounded-full px-3 py-1 font-mono text-xs text-slate-300 transition hover:bg-white/5 hover:text-white"><Icon name="open-in-new" class="size-4" />{f.repo}</a>
    </div>
  </div>
</footer>
