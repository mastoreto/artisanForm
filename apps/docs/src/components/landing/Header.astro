---
import { project } from '../../data/project';
import type { LandingCopy } from '../../i18n/landing.en';
import Icon from '../ui/Icon.astro';
import Pill from '../ui/Pill.astro';

interface Props {
  t: LandingCopy;
}
const { t } = Astro.props;
---
<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-volcano-900/90 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-2 px-4 sm:gap-4 sm:px-6 lg:px-12">
    <div class="flex items-center gap-4">
      <a href={t.home} class="group flex items-center gap-2" aria-label="ArtisanForm">
        <img src="/favicon.svg" alt="" width="32" height="32" class="size-8" />
        <span class="font-display text-lg font-semibold tracking-tight text-white">ArtisanForm</span>
      </a>
      <span class="hidden sm:block"><Pill class="font-mono">v{project.version}</Pill></span>
    </div>
    <nav aria-label={t.nav.label} class="hidden items-center gap-1 rounded-full border border-white/10 bg-white/[0.04] p-1 xl:flex">
      {t.nav.items.map((item) => (
        <a href={item.href} class="rounded-full px-3.5 py-1.5 text-xs text-slate-300 transition hover:bg-white/5 hover:text-white">{item.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2.5">
      <a href={t.docsHref} class="flex items-center gap-2 rounded-xl border border-white/10 bg-volcano-850/80 px-3 py-2 text-xs text-slate-200 transition hover:border-iron-600 hover:text-white">
        <Icon name="menu-book" class="size-4" />{t.nav.docsCta}
      </a>
      <a href={t.otherLang.href} hreflang={t.otherLang.href === '/' ? 'en' : 'es'} lang={t.otherLang.href === '/' ? 'en' : 'es'} class="rounded-xl border border-white/10 bg-white/5 px-3 py-1.5 text-xs text-slate-200 transition hover:bg-white/10">{t.otherLang.label}</a>
      <a href={project.repo} target="_blank" rel="noopener noreferrer" aria-label={t.nav.github} class="flex items-center gap-1.5 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-xs font-semibold text-slate-200 transition hover:bg-white/10 active:scale-95">
        <Icon name="code" class="size-4 text-slag" /><span class="hidden sm:inline">{t.nav.github}</span>
      </a>
    </div>
  </div>
</header>
