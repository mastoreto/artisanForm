---
import { project } from '../../data/project';
import type { LandingCopy } from '../../i18n/landing.en';
import Icon from '../ui/Icon.astro';
import Pill from '../ui/Pill.astro';

interface Props {
  t: LandingCopy;
}
const { t } = Astro.props;
---
<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-volcano-900/90 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-2 px-4 sm:gap-4 sm:px-6 lg:px-12">
    <div class="flex items-center gap-4">
      <a href={t.home} class="group flex min-h-11 items-center gap-2" aria-label="ArtisanForm">
        <img src="/favicon.svg" alt="" width="32" height="32" class="size-8" />
        <span class="font-display text-lg font-semibold tracking-tight text-white">ArtisanForm</span>
      </a>
      <span class="hidden sm:block"><Pill class="font-mono">v{project.version}</Pill></span>
    </div>
    <nav aria-label={t.nav.label} class="hidden items-center gap-1 rounded-full border border-white/10 bg-white/[0.04] p-1 xl:flex">
      {t.nav.items.map((item) => (
        <a href={item.href} class="rounded-full px-3.5 py-1.5 text-xs text-slate-300 transition hover:bg-white/5 hover:text-white">{item.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2.5">
      <details data-menu class="group xl:hidden">
        <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-3 text-xs text-slate-200 transition hover:bg-white/10 [&::-webkit-details-marker]:hidden">
          <Icon name="menu" class="size-4" /><span class="hidden sm:inline">{t.nav.menu}</span><span class="sr-only sm:hidden">{t.nav.menu}</span>
        </summary>
        <nav aria-label={t.nav.label} class="fixed inset-x-4 top-[4.5rem] flex flex-col rounded-2xl border border-white/10 bg-volcano-900 p-2 shadow-2xl sm:left-auto sm:w-64">
          {t.nav.items.filter((i) => i.href !== t.docsHref).map((item) => (
            <a href={item.href} class="flex min-h-11 items-center rounded-xl px-3 text-sm text-slate-200 hover:bg-white/5 hover:text-white">{item.label}</a>
          ))}
        </nav>
      </details>
      <a href={t.docsHref} class="flex items-center gap-2 rounded-xl border border-white/10 bg-volcano-850/80 min-h-11 px-3 text-xs text-slate-200 transition hover:border-iron-600 hover:text-white">
        <Icon name="menu-book" class="size-4" />{t.nav.docsCta}
      </a>
      <a href={t.otherLang.href} hreflang={t.otherLang.href === '/' ? 'en' : 'es'} lang={t.otherLang.href === '/' ? 'en' : 'es'} class="inline-flex min-h-11 items-center rounded-xl border border-white/10 bg-white/5 px-3 text-xs text-slate-200 transition hover:bg-white/10">{t.otherLang.label}</a>
      <a href={project.repo} target="_blank" rel="noopener noreferrer" aria-label={t.nav.github} class="hidden min-h-11 items-center gap-1.5 rounded-xl border border-white/10 bg-white/5 px-3 text-xs font-semibold sm:flex text-slate-200 transition hover:bg-white/10 active:scale-95">
        <Icon name="code" class="size-4 text-slag" /><span>{t.nav.github}</span>
      </a>
    </div>
  </div>
</header>
