---
import { Code } from 'astro:components';
import Icon from './Icon.astro';
import Pill from './Pill.astro';

interface Props {
  file: string;
  code: string;
  lang?: string;
  badge?: string;
  copy?: { label: string; done: string };
  id?: string;
  class?: string;
}
const {
  file,
  code,
  lang = 'tsx',
  badge,
  copy,
  id,
  class: className = '',
} = Astro.props;
---
<div id={id} class:list={['code-window surface overflow-hidden shadow-2xl shadow-black/40', className]}>
  <div class="flex items-center justify-between border-b border-white/10 bg-white/[0.04] px-5 py-3">
    <div class="flex items-center gap-2">
      <span class="font-mono text-xs text-slate-300">{file}</span>
    </div>
    {badge && <Pill>{badge}</Pill>}
    {copy && (
      <button type="button" data-copy={code} data-copied={copy.done} class="inline-flex min-h-11 items-center gap-1.5 rounded-xl border border-white/10 bg-white/5 px-3 font-mono text-xs text-slate-300 transition hover:bg-white/10 hover:text-white active:scale-95">
        <Icon name="content-copy" class="size-3.5 text-slag" /><span data-copy-label>{copy.label}</span>
      </button>
    )}
  </div>
  <Code code={code} lang={lang} theme="github-dark-default" />
  <slot />
</div>
