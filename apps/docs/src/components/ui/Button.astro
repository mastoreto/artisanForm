---
interface Props {
  href?: string;
  variant?: 'forge' | 'iron';
  external?: boolean;
  class?: string;
  [attr: string]: unknown;
}
const {
  href,
  variant = 'forge',
  external = false,
  class: className = '',
  ...rest
} = Astro.props;
const base =
  'inline-flex items-center justify-center gap-2.5 rounded-xl border px-6 py-3 font-display text-base font-medium transition active:scale-95 cursor-pointer';
const variants = {
  forge:
    'border-white/20 bg-gradient-to-r from-ember to-amber-500 text-white shadow-lg shadow-orange-500/25 hover:-translate-y-0.5 hover:from-orange-600 hover:to-amber-600',
  iron: 'border-iron-700 bg-volcano-850 text-zinc-200 hover:border-iron-600 hover:text-white',
};
const Tag = href ? 'a' : 'button';
const props = href
  ? {
      href,
      ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}),
    }
  : { type: 'button' };
---
<Tag class:list={[base, variants[variant], className]} {...props} {...rest}><slot /></Tag>
