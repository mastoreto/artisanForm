---
import Icon from './Icon.astro';
import Pill from './Pill.astro';

interface Props {
  eyebrow: string;
  icon?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  titleId?: string;
}
const { eyebrow, icon, title, lead, align = 'left', titleId } = Astro.props;
---
<div class:list={[align === 'center' && 'mx-auto text-center', 'max-w-3xl']}>
  <Pill class="mb-3 uppercase tracking-wider">
    {icon && <Icon name={icon} />}{eyebrow}
  </Pill>
  <h2 id={titleId} class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">{title}</h2>
  {lead && <p class="mt-3 text-lg text-zinc-400">{lead}</p>}
</div>
