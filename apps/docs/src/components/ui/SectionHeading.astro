---
interface Props {
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  titleId?: string;
}
const { title, lead, align = 'left', titleId } = Astro.props;
---
<div class:list={[align === 'center' && 'mx-auto text-center', 'max-w-3xl']}>
  <h2 id={titleId} class="font-display text-3xl font-semibold tracking-tight text-white sm:text-4xl">{title}</h2>
  {lead && <p class="mt-3 text-lg text-slag">{lead}</p>}
</div>
