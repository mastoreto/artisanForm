---
import Icon from './Icon.astro';

interface Props {
  icon: string;
  title: string;
  tone?: 'ember' | 'amber';
}
const { icon, title, tone = 'ember' } = Astro.props;
const tones = {
  ember: 'bg-orange-500/10 border-orange-500/20 text-orange-400',
  amber: 'bg-amber-500/10 border-amber-500/20 text-amber-400',
};
---
<div class="surface flex items-start gap-4 p-6">
  <div class:list={['flex size-10 shrink-0 items-center justify-center rounded-xl border', tones[tone]]}>
    <Icon name={icon} class="size-5" />
  </div>
  <div>
    <h3 class="font-display text-base font-semibold text-white">{title}</h3>
    <p class="mt-1.5 text-sm leading-relaxed text-zinc-400"><slot /></p>
  </div>
</div>
