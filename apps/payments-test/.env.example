# Copy to .env.local (git-ignored) and fill in only the providers you want to
# try. A provider with missing values is reported as "not configured" and left
# out of the payment step. Never commit real keys; use sandbox/test ones.

# Port of the test backend (the web app proxies /api to it).
PORT=8787
# Origins allowed as return/cancel URLs (comma separated).
ALLOWED_ORIGINS=http://localhost:5858
# Default currency (ISO 4217). Override per provider: STRIPE_CURRENCY, …
CURRENCY=USD

# --- Stripe (https://dashboard.stripe.com/test/apikeys) ---
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
# Signing secret of the webhook endpoint or of `stripe listen` (whsec_…); optional:
# payment state is read from Stripe's API, the webhook is only logged at /api/stripe/events.
STRIPE_WEBHOOK_SECRET=

# --- PayPal sandbox (https://developer.paypal.com/dashboard/applications/sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_ENV=sandbox

# --- Mercado Pago (test credentials of a test seller user; MP only accepts
# --- the currency of the seller's country, e.g. MP_CURRENCY=ARS) ---
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# MP_CURRENCY=ARS
# Payment Brick only (the payments API): forces the payer e-mail, because it
# rejects fake @testuser.com payers and your own MP account. It is an ordinary
# address, so it is NOT sent to Checkout Pro.
# MP_PAYER_EMAIL=buyer1@example.com
# Checkout Pro (optional): the e-mail of your TEST BUYER user, never an ordinary
# address and never the seller's. With a TEST seller, a payer that is not a test
# buyer ends in "una de las partes con la que intentas hacer el pago es de prueba".
# MP_CHECKOUT_PAYER_EMAIL=test_user_123456@testuser.com
# Secret signature of the webhook pointing to <public-url>/api/mercadopago/webhook
MP_WEBHOOK_SECRET=

# --- Lemon Squeezy (test mode). Prices live on the variant, not here. ---
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_TEAM=
# Signing secret of the webhook pointing to <public-url>/api/lemonsqueezy/webhook
LEMONSQUEEZY_WEBHOOK_SECRET=
