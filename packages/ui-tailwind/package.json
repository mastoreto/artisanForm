{
  "name": "@beardartisans/ui-tailwind",
  "version": "1.0.0-rc.3",
  "description": "Tailwind CSS kit for ArtisanForm",
  "license": "MIT",
  "author": "ArtisanForm contributors",
  "homepage": "https://github.com/mastoreto/artisanForm/tree/develop/packages/ui-tailwind#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastoreto/artisanForm.git",
    "directory": "packages/ui-tailwind"
  },
  "bugs": {
    "url": "https://github.com/mastoreto/artisanForm/issues"
  },
  "keywords": [
    "artisanform",
    "react",
    "form",
    "ui-kit",
    "tailwind"
  ],
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/prepublish-check.mjs --skip-consumer",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check": "publint --strict"
  },
  "peerDependencies": {
    "artisanform": "^1.0.0-rc.3"
  },
  "devDependencies": {
    "artisanform": "link:../.."
  },
  "publishConfig": {
    "access": "public"
  }
}
