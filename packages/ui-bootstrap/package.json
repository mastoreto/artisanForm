{
  "name": "@beardartisans/ui-bootstrap",
  "version": "1.0.0-rc.3",
  "description": "Bootstrap 5 UI kit for ArtisanForm",
  "license": "MIT",
  "author": "ArtisanForm contributors",
  "homepage": "https://github.com/mastoreto/artisanForm/tree/develop/packages/ui-bootstrap#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastoreto/artisanForm.git",
    "directory": "packages/ui-bootstrap"
  },
  "bugs": {
    "url": "https://github.com/mastoreto/artisanForm/issues"
  },
  "keywords": [
    "artisanform",
    "react",
    "form",
    "ui-kit",
    "bootstrap"
  ],
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/prepublish-check.mjs --skip-consumer",
    "build": "vite build && cp src/style.css dist/style.css",
    "typecheck": "tsc --noEmit",
    "check": "publint --strict"
  },
  "peerDependencies": {
    "artisanform": "^1.0.0-rc.3"
  },
  "devDependencies": {
    "artisanform": "link:../.."
  },
  "publishConfig": {
    "access": "public"
  }
}
