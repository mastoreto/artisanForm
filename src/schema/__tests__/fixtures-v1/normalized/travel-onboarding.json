{
  "schemaVersion": 1,
  "id": "travel-onboarding",
  "steps": [
    {
      "id": "you",
      "type": "form",
      "title": "Welcome",
      "fields": [
        {
          "type": "text",
          "name": "name",
          "label": "What should we call you?",
          "required": true,
          "ui": {
            "span": 2
          }
        },
        {
          "type": "combobox",
          "name": "home",
          "label": "Home airport",
          "placeholder": "Start typing…",
          "options": [
            {
              "value": "madrid-mad",
              "label": "Madrid MAD"
            },
            {
              "value": "lisbon-lis",
              "label": "Lisbon LIS"
            },
            {
              "value": "buenos-aires-eze",
              "label": "Buenos Aires EZE"
            },
            {
              "value": "mexico-city-mex",
              "label": "Mexico City MEX"
            },
            {
              "value": "bogota-bog",
              "label": "Bogota BOG"
            },
            {
              "value": "montevideo-mvd",
              "label": "Montevideo MVD"
            }
          ],
          "ui": {
            "span": 2
          }
        }
      ],
      "ui": {
        "columns": 2
      }
    },
    {
      "id": "style",
      "type": "form",
      "title": "Your style",
      "fields": [
        {
          "type": "radio",
          "name": "pace",
          "label": "Travel pace",
          "required": true,
          "options": [
            {
              "value": "slow",
              "label": "Slow"
            },
            {
              "value": "balanced",
              "label": "Balanced"
            },
            {
              "value": "packed",
              "label": "Packed"
            }
          ],
          "ui": {
            "span": 2
          }
        },
        {
          "type": "multiselect",
          "name": "interests",
          "label": "Interests",
          "options": [
            {
              "value": "food",
              "label": "Food"
            },
            {
              "value": "hiking",
              "label": "Hiking"
            },
            {
              "value": "museums",
              "label": "Museums"
            },
            {
              "value": "beaches",
              "label": "Beaches"
            },
            {
              "value": "nightlife",
              "label": "Nightlife"
            }
          ],
          "ui": {
            "span": 2
          }
        },
        {
          "type": "range",
          "name": "budget",
          "label": "Daily budget (USD)",
          "defaultValue": 120,
          "step": 10,
          "validation": {
            "min": 30,
            "max": 500
          },
          "ui": {
            "span": 2
          }
        }
      ],
      "ui": {
        "columns": 2
      }
    },
    {
      "id": "dates",
      "type": "form",
      "title": "First trip",
      "fields": [
        {
          "type": "daterange",
          "name": "from",
          "endName": "to",
          "label": "Leaving",
          "endLabel": "Coming back",
          "validation": {
            "min": "2026-11-12"
          },
          "ui": {
            "span": 2
          }
        }
      ],
      "ui": {
        "columns": 2
      }
    },
    {
      "id": "alerts",
      "type": "form",
      "title": "Alerts",
      "fields": [
        {
          "type": "switch",
          "name": "deals",
          "label": "Tell me about fare drops",
          "ui": {
            "span": 2
          }
        },
        {
          "type": "tel",
          "name": "phone",
          "label": "Phone for SMS alerts",
          "visibleWhen": {
            "field": "deals",
            "operator": "eq",
            "value": true
          },
          "ui": {
            "span": 2
          }
        }
      ],
      "ui": {
        "columns": 2
      }
    },
    {
      "id": "done",
      "type": "result",
      "title": "Done",
      "message": "Your profile is ready. Let us find your first trip.",
      "actions": [
        {
          "label": "Start over",
          "action": "restart"
        }
      ]
    }
  ],
  "ui": {
    "layout": "vertical",
    "density": "comfortable",
    "labelPosition": "top"
  }
}
