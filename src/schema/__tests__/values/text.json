{
  "description": "Text-like fields: required, length, pattern, email, url, tel, sameAs",
  "schema": {
    "schemaVersion": 1,
    "id": "text",
    "steps": [
      {
        "id": "main",
        "type": "form",
        "title": "Main",
        "fields": [
          {
            "type": "text",
            "name": "name",
            "required": true,
            "validation": {
              "minLength": 2,
              "maxLength": 5
            }
          },
          {
            "type": "text",
            "name": "code",
            "validation": {
              "pattern": "^[A-Z]{2}[0-9]{2}$"
            }
          },
          {
            "type": "email",
            "name": "email",
            "required": true
          },
          {
            "type": "url",
            "name": "site"
          },
          {
            "type": "tel",
            "name": "phone"
          },
          {
            "type": "password",
            "name": "pw",
            "required": true
          },
          {
            "type": "password",
            "name": "pw2",
            "required": true,
            "validation": {
              "sameAs": "pw"
            }
          },
          {
            "type": "textarea",
            "name": "notes"
          }
        ]
      },
      {
        "id": "done",
        "type": "result",
        "title": "Done"
      }
    ]
  },
  "cases": [
    {
      "name": "all valid",
      "values": {
        "name": "Ana",
        "code": "AB12",
        "email": "a@b.co",
        "site": "https://x.dev",
        "phone": "+54 11 5555-1234",
        "pw": "secret",
        "pw2": "secret"
      },
      "expect": []
    },
    {
      "name": "required fields missing",
      "values": {},
      "expect": [
        {
          "path": "name",
          "code": "required"
        },
        {
          "path": "email",
          "code": "required"
        },
        {
          "path": "pw",
          "code": "required"
        },
        {
          "path": "pw2",
          "code": "required"
        }
      ]
    },
    {
      "name": "too short and too long",
      "values": {
        "name": "A",
        "email": "a@b.co",
        "pw": "x",
        "pw2": "x"
      },
      "expect": [
        {
          "path": "name",
          "code": "minLength"
        }
      ]
    },
    {
      "name": "too long",
      "values": {
        "name": "Anabel",
        "email": "a@b.co",
        "pw": "x",
        "pw2": "x"
      },
      "expect": [
        {
          "path": "name",
          "code": "maxLength"
        }
      ]
    },
    {
      "name": "pattern mismatch",
      "values": {
        "name": "Ana",
        "code": "abc",
        "email": "a@b.co",
        "pw": "x",
        "pw2": "x"
      },
      "expect": [
        {
          "path": "code",
          "code": "pattern"
        }
      ]
    },
    {
      "name": "bad email",
      "values": {
        "name": "Ana",
        "email": "not-an-email",
        "pw": "x",
        "pw2": "x"
      },
      "expect": [
        {
          "path": "email",
          "code": "invalidEmail"
        }
      ]
    },
    {
      "name": "bad url",
      "values": {
        "name": "Ana",
        "email": "a@b.co",
        "site": "nope",
        "pw": "x",
        "pw2": "x"
      },
      "expect": [
        {
          "path": "site",
          "code": "invalidUrl"
        }
      ]
    },
    {
      "name": "bad phone",
      "values": {
        "name": "Ana",
        "email": "a@b.co",
        "phone": "12",
        "pw": "x",
        "pw2": "x"
      },
      "expect": [
        {
          "path": "phone",
          "code": "invalidPhone"
        }
      ]
    },
    {
      "name": "passwords differ",
      "values": {
        "name": "Ana",
        "email": "a@b.co",
        "pw": "x",
        "pw2": "y"
      },
      "expect": [
        {
          "path": "pw2",
          "code": "mustMatch"
        }
      ]
    },
    {
      "name": "empty optional strings are fine",
      "values": {
        "name": "Ana",
        "code": "",
        "email": "a@b.co",
        "site": "",
        "phone": "",
        "pw": "x",
        "pw2": "x"
      },
      "expect": []
    },
    {
      "name": "a number where a string is expected",
      "values": {
        "name": 55,
        "email": "a@b.co",
        "pw": "x",
        "pw2": "x"
      },
      "expect": [
        {
          "path": "name",
          "code": "type"
        }
      ],
      "serverOnly": true,
      "note": "Yup casts 55 to '55' and accepts it; the server does not"
    },
    {
      "name": "a string too long to be tested",
      "values": {
        "name": "Ana",
        "email": "a@b.co",
        "pw": "x",
        "pw2": "x",
        "notes": ""
      },
      "expect": [
        {
          "path": "notes",
          "code": "tooLong"
        }
      ],
      "serverOnly": true
    },
    {
      "name": "values exactly at the length limits are valid",
      "values": {
        "email": "a@b.co",
        "pw": "x",
        "pw2": "x",
        "name": "An"
      },
      "expect": []
    },
    {
      "name": "the maximum length is valid",
      "values": {
        "email": "a@b.co",
        "pw": "x",
        "pw2": "x",
        "name": "Anabe"
      },
      "expect": []
    }
  ]
}
